#!/usr/bin/env php
<?php

namespace BHayes\CLI;

//to allow this to run any class by name as a global command, first check for a localized autoloader.
if (file_exists('vendor/autoload.php')) {
    include_once 'vendor/autoload.php';
}
//manually include this version of CLI files in case it is also installed as a project package in the cwd.
require_once __DIR__ . '/../php/UserResponse.php';
foreach (glob(__DIR__ . '/../php/CLI.php') as $file) {
    require_once $file;
}

if (php_sapi_name() != 'cli') {
    throw new \Error("This is a command line tool only.");
}

$subject = null;
if (count($argv) === 1) {
    echo "Specify a class name to run it as a CLI app.\n";
    echo "Usage: ${argv[0]} <classname>\n";
    exit(0);
}

$potentialSubject = $argv[1];
If (!class_exists($potentialSubject)) {
    echo "Class '$potentialSubject' does not exist.\n";
    echo " - check the spelling.\n";
    echo " - try running 'composer dump-autoload' to generate the autoloader.\n";
    echo CLI::class, "\n";
    exit(1);
}

$subject = new $potentialSubject();

//clean up the argv before it's processed by the CLI class.
unset($argv[1]);
$argv = array_values($argv);

(new CLI($subject))->run();

